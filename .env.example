# 复制为 .env 后修改。所有变量前缀 KNOWBASE_。真实密钥只放在 .env / 密钥管理系统里,绝不提交到仓库。
# 注意:注释必须单独占一行,不要写在变量值的后面。

# dev | test | prod(prod 会强校验密钥/数据库/向量库配置)
KNOWBASE_ENV=dev
KNOWBASE_COMPANY_NAME=示例科技
KNOWBASE_HELPDESK_CONTACT=HR 热线 8001 / IT 服务台 8000

# --- 安全 ---
# 生成方式: python -c "import secrets;print(secrets.token_urlsafe(48))"
KNOWBASE_SECRET_KEY=dev-only-secret-change-me
KNOWBASE_ACCESS_TOKEN_EXPIRE_MINUTES=480
KNOWBASE_RATE_LIMIT_PER_MINUTE=30
# true = 问题中的手机号/身份证/银行卡/邮箱在检索、调用 LLM、落库前先脱敏
KNOWBASE_MASK_PII=true
# /metrics 的 Bearer 令牌;生产环境不配置则该端点不可用。生成方式同上
# KNOWBASE_METRICS_TOKEN=
# 前后端分离时填前端域名,例如 ["https://kb.example.com"];同域部署保持 []
KNOWBASE_CORS_ORIGINS=[]

# --- 存储 ---
# 生产示例: mysql+pymysql://user:pass@mysql:3306/knowbase?charset=utf8mb4
KNOWBASE_DATABASE_URL=sqlite:///./knowbase.db
# 生产示例: redis://:password@redis:6379/0 ;不设置则使用进程内存(仅限单实例)
# KNOWBASE_REDIS_URL=

# --- 检索 ---
# 开发/演示用 memory(纯 BM25,无需模型);生产用 milvus
KNOWBASE_RETRIEVER_BACKEND=memory
KNOWBASE_MILVUS_URI=http://localhost:19530
# 其下放 bge-m3/ 与 bge-reranker-large/
KNOWBASE_MODEL_DIR=./models
# 低于此相关度视为"知识库里没有",触发拒答;上线前用 python -m scripts.evaluate_rag 标定
KNOWBASE_MIN_RELEVANCE=0.30

# --- LLM(任意 OpenAI 兼容接口)---
# 示例: 公有云网关 https://<gateway>/v1 ;私有化 vLLM http://vllm:8000/v1 ;Ollama http://ollama:11434/v1
KNOWBASE_LLM_BASE_URL=
# 密钥只通过环境变量或密钥管理系统注入,禁止写入代码与镜像
KNOWBASE_LLM_API_KEY=
KNOWBASE_LLM_MODEL=
# false = 一律直接检索,省一次 LLM 调用
KNOWBASE_ENABLE_STRATEGY_LLM=true
# true = 多轮追问(如"那病假呢")先补全为完整问题再检索
KNOWBASE_ENABLE_QUERY_REWRITE=true
# 企业场景建议保持 false(不让模型脱离知识库回答)
KNOWBASE_ALLOW_GENERAL_KNOWLEDGE=false

# --- docker-compose 使用 ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
